{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PREFACE Samplesheet",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "filepath"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "filepath": {
        "type": "string",
        "minLength": 1
      },
      "index": {
        "type": ["string", "null"],
        "minLength": 1,
        "pattern": "\\.(gzi|bai|csi|crai)$"
      },
      "sex": {
        "type": ["string", "null"],
        "enum": ["M", "F", null]
      },
      "ff": {
        "type": ["number", "null"],
        "minimum": 0.0,
        "maximum": 1.0
      }
    }
  }
}
